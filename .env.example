# Server/runtime secrets. Never expose these with VITE_*.
DATABASE_URL=postgres://car_market_watch:car_market_watch@localhost:5433/car_market_watch
DATABASE_SSL=false

# `json` keeps the current static artifact path. Use `db` for DB-backed ingestion workers.
INGESTION_DB_MODE=json

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5173

# Optional crawler knobs for manual/live ingestion.
SCRAPER_USER_AGENT=CarMarketWatchBot/0.1 (contact: you@example.com)
SCRAPER_PAGE_COUNT=1
SCRAPER_REQUEST_DELAY_MS=1000
